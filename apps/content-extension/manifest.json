{
  "manifest_version": 3,
  "name": "Ego Content",
  "version": "0.3.0",
  "description": "Save the current page to your Ego library and turn Canvas dark.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://ego-money.ega-khar.workers.dev/*",
    "https://*.instructure.com/*",
    "https://*.cloudfront.net/*",
    "https://*.amazonaws.com/*",
    "https://*.ciditools.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "exclude_matches": [
        "https://instructure.com/*",
        "https://www.instructure.com/*",
        "https://community.instructure.com/*"
      ],
      "css": [
        "canvas-dark.css"
      ],
      "js": [
        "canvas-dark.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Save to Ego",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  }
}
