{
  "expo": {
    "name": "Ego",
    "slug": "ego",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "ego",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121214",
    "android": {
      "package": "com.kharitonovegor.ego",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121214"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.kharitonovegor.ego",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ego uses photos you choose for your diary, Trello attachments, and transaction image analysis.",
          "cameraPermission": "Ego uses the camera for diary photos and videos and to analyze a transaction image.",
          "microphonePermission": "Ego records sound when you film a video for your diary."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#121214"
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Ego records voice messages for your diary.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-image",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ego uses Face ID to unlock Mood and Diary."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4caa3de-f925-49ac-a271-0fb68df066ab"
      }
    },
    "owner": "kharitonov",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a4caa3de-f925-49ac-a271-0fb68df066ab"
    }
  }
}
