{
  "name": "@ego/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build:preview": "eas build --profile preview --platform android",
    "update": "eas update --branch preview --environment preview",
    "test": "vitest run",
    "eas-build-post-install": "npm run build --workspace @ego/core && npm run build --workspace @ego/api-contracts && npm run build --workspace @ego/local"
  },
  "dependencies": {
    "@ego/api-contracts": "*",
    "@ego/core": "*",
    "@ego/local": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.17",
    "expo-application": "~57.0.2",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.15",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.14",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.18",
    "expo-video": "~57.0.5",
    "expo-video-thumbnails": "~57.0.2",
    "lottie-react-native": "~7.3.8",
    "lucide-react-native": "^1.34.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
