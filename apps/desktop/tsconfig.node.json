{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "lib": ["ESNext"],
    "outDir": "./out/types/node",
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "paths": {
      "@ego/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "../../packages/ui/src/platform/**/*",
    "electron.vite.config.ts"
  ]
}
