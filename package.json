{
  "name": "ego",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.0",
  "description": "My personal super app",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "desktop": "npm run dev --workspace @ego/desktop",
    "mobile": "npm run start --workspace @ego/mobile"
  },
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "turbo": "^2.3.3"
  }
}
